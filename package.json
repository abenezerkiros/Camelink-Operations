{
  "name": "camelink-operations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --test tests/*.test.js",
    "backend:build": "npm --prefix backend run build",
    "test:integration": "npm run backend:build && firebase emulators:exec --only auth,firestore --project demo-camelink \"node --test --test-concurrency=1 tests/integration/*.test.mjs\""
  },
  "dependencies": {
    "firebase": "13.1.0",
    "mapbox-gl": "3.34.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-tools": "14.27.0"
  }
}
